# Copy thành docker/.env rồi sửa. ./knrt.sh tự tạo file này ở lần chạy đầu.
# KHÔNG commit docker/.env.

COMPOSE_PROJECT_NAME=knrt

# Mật khẩu root MySQL. Mặc định xpymw.com là bản đang chạy trên Windows —
# đổi thì phải đổi đồng bộ 5 chỗ khác, xem docker/README.md mục "Đổi mật khẩu DB".
MYSQL_ROOT_PASSWORD=xpymw.com

TZ=Asia/Ho_Chi_Minh

# UID/GID chủ sở hữu file trong src/. ./knrt.sh điền id -u / id -g của bạn.
# Để container không tạo file root trong scriptBin/, logs/, server.pid.
KNRT_UID=1000
KNRT_GID=1000

# IP public của VPS. `./knrt.sh setup-ip <ip>` tự ghi vào đây, và db-install đọc
# lại để khôi phục hàng t_s_server_list mà nó vừa ghi đè mất. Để trống cũng được:
# setup-ip sẽ tự dò bằng `ip route get 1.1.1.1`.
KNRT_PUBLIC_IP=

# --- Image, chỉ đổi khi biết rõ hệ quả -------------------------------------
# mysql:5.6 khớp bản Windows và khớp mysql-connector-java 5.0.7 trong lib/.
# MySQL 8 sẽ gãy: connector đời 2007 không nói được caching_sha2_password.
MYSQL_IMAGE=mysql:5.6

# Phải là JDK, không phải JRE: GameServer biên dịch scripts/java lúc chạy.
JAVA_IMAGE=eclipse-temurin:8-jdk

NGINX_IMAGE=nginx:1.27-alpine
