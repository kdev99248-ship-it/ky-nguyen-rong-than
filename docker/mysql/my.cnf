# Bản Linux của db/mysql/my.ini.
# Image mysql:5.6 nạp file này qua !includedir /etc/mysql/conf.d/.
# basedir/datadir bỏ đi — image tự quản (datadir = /var/lib/mysql, volume knrt-mysql-data).

[mysqld]
port                   = 3306

# Chỉ nghe loopback. Vì mọi container đều dùng network_mode: host nên chúng vẫn
# nối được qua 127.0.0.1, còn từ Internet thì không — VPS không hở cổng 3306.
bind-address           = 127.0.0.1

character-set-server   = utf8
collation-server       = utf8_general_ci
default-storage-engine = MyISAM
max_connections        = 512

# Giữ y hệt my.ini. Quan trọng khi nào đổi lên 5.7: mặc định 5.7 thêm
# ONLY_FULL_GROUP_BY + STRICT_TRANS_TABLES, đủ để gãy các câu SQL đời cũ trong jar.
sql-mode               = "NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"

# Windows luôn hành xử như lower_case_table_names=1; Linux mặc định 0 (phân biệt
# hoa thường). 253 bảng trong db/sql/install/ đều viết thường nên 0 cũng chạy,
# nhưng các câu SQL biên dịch sẵn trong jar thì không kiểm chứng được — đặt 1 cho
# giống hệt Windows.
# CHỈ CÓ TÁC DỤNG khi datadir còn trống. Đổi sau khi đã nạp dữ liệu là hỏng bảng:
# phải dump, xoá volume, đổi giá trị, rồi nạp lại.
lower_case_table_names = 1

# my.ini không đặt, mặc định 5.6 là 4M. Bộ install/ nạp lọt, nhưng
# backup-2023-06-10/h_game.sql (147 MB) thì đứt giữa chừng vì "MySQL server has gone away".
max_allowed_packet     = 64M

[client]
port                  = 3306
default-character-set = utf8

[mysql]
default-character-set = utf8
