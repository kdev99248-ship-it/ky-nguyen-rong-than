<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="20220306131600-1" author="dokd">
        <createTable tableName="webshop_log">
            <column name="id" type="int(11)" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="int(11)">
                <constraints nullable="false"/>
            </column>
            <column name="player_id" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="id_item" type="int(11)">
                <constraints nullable="false"/>
            </column>
            <column name="name_item" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="int(11)" defaultValue="10">
            </column>
            <column name="price" type="int(11)" defaultValue="10000">
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="created_on" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="updated_by" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="updated_on" type="datetime">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20220306131600-2" author="dokd">
        <addColumn tableName="webshop_log">
            <column name="expression" type="varchar(256)">
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20220306131600-3" author="dokd">
        <dropColumn tableName="webshop_log" columnName="id_item"/>
    </changeSet>

    <changeSet id="20220306131600-4" author="dokd">
        <addColumn tableName="webshop_log">
            <column name="webshop_id" type="int(11)">
            </column>
            <column name="server_id" type="int(11)">
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>