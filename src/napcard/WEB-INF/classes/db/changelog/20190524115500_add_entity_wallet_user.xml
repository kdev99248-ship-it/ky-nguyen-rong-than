<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="20190323134000-1" author="dokd">
        <createTable tableName="wallet_user">
            <column name="id" type="int(11)" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="int(11)">/
                <constraints nullable="false"/>
            </column>
            <column name="type_network" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="card_value" type="int(11)">
            </column>
            <column name="seri_num" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="secret_num" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="int(11)" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="created_on" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="updated_by" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="updated_on" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="response_first_face" type="nvarchar(5000)">
                <constraints nullable="true"/>
            </column>
            <column name="response_call_back" type="nvarchar(5000)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>