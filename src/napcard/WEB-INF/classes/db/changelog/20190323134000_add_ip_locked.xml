<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="20200916195900-1" author="dokd">
        <createTable tableName="ip_locked">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ip_address" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="path_request" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="date_execute" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20200916200000-1" author="dokd">
        <createTable tableName="ip_block">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ip_address" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>