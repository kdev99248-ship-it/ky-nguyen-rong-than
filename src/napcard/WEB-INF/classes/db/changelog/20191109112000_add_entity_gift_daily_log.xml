<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="20220309194500-1" author="dokd">
        <createTable tableName="gift_daily_log">
            <column name="id" type="int(11)" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="gift_id" type="int(11)">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="int(11)">
                <constraints nullable="false"/>
            </column>
            <column name="server_id" type="int(11)">
                <constraints nullable="false"/>
            </column>
            <column name="last_receiver" type="datetime">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="20220309194500-2" author="dokd">
        <modifyDataType tableName="gift_daily_log" columnName="member_id" newDataType="varchar(50)"/>
    </changeSet>
</databaseChangeLog>